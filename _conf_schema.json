{
  "bridge_settings": {
    "description": "① 群服互联、翻译与 Discord 频道策略",
    "type": "object",
    "hint": "配置 QQ 群、Discord 频道与 Minecraft 的双向聊天。建议直接在目标会话执行 /mc bridge_add，不必手填会话 ID。",
    "obvious_hint": true,
    "items": {
      "bridge_enabled": {
        "description": "启用群服互联",
        "type": "bool",
        "hint": "启用后，桥接会话列表中的 QQ 群或 Discord 频道会与 Minecraft 双向转发文本消息。",
        "default": true
      },
      "relay_sessions": {
        "description": "桥接会话列表（每行一个）",
        "type": "text",
        "hint": "推荐在目标群/频道执行 /mc bridge_add 自动写入。手填时每行一个 AstrBot unified_msg_origin。",
        "obvious_hint": true,
        "default": ""
      },
      "relay_routes": {
        "description": "妗ユ帴璺敱闄愬埗",
        "type": "text",
        "hint": "姣忚涓€鏉¤矾鐢憋細channelA <-> channelB锛屾垨 source => target1,target2锛涚暀绌轰负鎵€鏈夋潯鐩叏灏忓苟杩炴帴銆?",
        "default": ""
      },
      "relay_prefix": {
        "description": "聊天平台转游戏前缀",
        "type": "string",
        "hint": "留空转发普通消息；设置后只有以此前缀开头的消息才会进入游戏。",
        "default": ""
      },
      "relay_wake_messages": {
        "description": "同时转发唤醒机器人消息",
        "type": "bool",
        "hint": "旧版兼容开关；新版推荐使用下一项同步完整的人机对话。",
        "default": false
      },
      "relay_bot_conversations_to_game": {
        "description": "把玩家 @机器人及机器人回复同步到游戏",
        "type": "bool",
        "hint": "开启后，桥接 QQ/Discord 中唤醒机器人的玩家消息会进入 MC，AstrBot 最终的纯文本回复也会进入 MC；不会转发只有 Reply/At 的空中间消息。",
        "obvious_hint": true,
        "default": true
      },
      "relay_commands": {
        "description": "把斜杠指令也转发进游戏聊天",
        "type": "bool",
        "hint": "这只控制聊天转发，不等于开启服务器远程命令。建议保持关闭。",
        "default": false
      },
      "chat_to_game_template": {
        "description": "聊天平台到游戏模板",
        "type": "string",
        "hint": "支持 {platform}、{sender}、{user_id}、{message}。",
        "default": "{message}"
      },
      "game_to_chat_template": {
        "description": "游戏到聊天平台模板",
        "type": "string",
        "hint": "支持 {server}、{server_id}、{player}、{player_uuid}、{message}。",
        "default": "[MC/{server}] {player}: {message}"
      },
      "chat_to_game_filters": {
        "description": "聊天平台到游戏过滤规则（每行一条）",
        "type": "text",
        "hint": "支持 $filter、$regex、$replaceTo 和 !CANCEL。",
        "default": ""
      },
      "game_to_chat_filters": {
        "description": "游戏到聊天平台过滤规则（每行一条）",
        "type": "text",
        "hint": "为避免 SSRF，只支持本地规则，不加载 $url 远程词库。",
        "default": ""
      },
      "max_relay_length": {
        "description": "跨平台转发最大字数",
        "type": "int",
        "hint": "超出长度会截断；Discord 自身仍有 2000 字限制。",
        "default": 500
      },
      "game_translation_enabled": {
        "description": "启用游戏内消息自动翻译",
        "type": "bool",
        "hint": "使用 AstrBot 文本模型把 QQ/Discord 消息和 AstrBot 回复翻译为各玩家客户端语言。会产生模型调用、延迟和费用，默认关闭。翻译失败时自动发送原文。",
        "obvious_hint": true,
        "default": false
      },
      "game_translation_provider_id": {
        "description": "翻译模型 Provider ID",
        "type": "string",
        "hint": "留空使用消息会话当前选择的文本模型；也可填写 AstrBot 提供商 ID 固定使用低成本翻译模型。",
        "default": ""
      },
      "game_translation_languages": {
        "description": "游戏内翻译目标语言（每行一个）",
        "type": "text",
        "hint": "使用 Minecraft locale，例如 zh_cn、en_us、ja_jp。服务端会按每位玩家客户端上报的语言选择最接近的译文；最多 8 种。",
        "default": "zh_cn\nen_us"
      },
      "game_translation_show_original": {
        "description": "默认同时显示原文",
        "type": "bool",
        "hint": "未安装客户端 Mod 的玩家使用此默认值；安装 v0.6.7 或更高版本客户端 Mod 后，玩家可在 F8 设置中自行选择翻译、翻译+原文或仅原文。",
        "default": true
      },
      "game_translation_timeout_seconds": {
        "description": "翻译等待超时（秒）",
        "type": "int",
        "hint": "超时后不阻塞聊天，直接发送原文。允许 1–60 秒。",
        "default": 20
      },
      "translation_context_messages": {
        "description": "翻译上下文消息数量",
        "type": "int",
        "hint": "0 表示不携带上下文，最多 20 条；上下文只用于帮助 AI 理解当前消息，不会被翻译。",
        "default": 0
      },
      "translation_custom_instructions": {
        "description": "统一翻译提示词 / 术语表",
        "type": "text",
        "hint": "游戏内、QQ、Discord 及其所有频道统一使用此设置。可逐行写专有名词、固定译名和风格要求，例如：Motiquies 固定译为 动静交映。同一条源消息会一次生成所有接收端需要的语言，再分别分发；最多使用前 4000 字。",
        "obvious_hint": true,
        "default": ""
      },
      "discord_channel_settings": {
        "description": "Discord 频道语言分发与通知设置",
        "type": "template_list",
        "hint": "可添加任意数量的频道配置。频道可选择自己接收的译文语言和是否显示原文，但翻译模型与提示词使用上方统一设置。QQ、Discord 与游戏端合计只统一翻译一次。",
        "obvious_hint": true,
        "default": [],
        "templates": {
          "discord_channel": {
            "name": "Discord 频道配置",
            "display_item": "name",
            "hide_hint_in_list": true,
            "items": {
              "name": {"description": "配置名称", "type": "string", "default": "Discord 频道"},
              "enabled": {"description": "启用此频道配置", "type": "bool", "default": true},
              "channel_ids": {"description": "Discord 频道 ID（每行一个）", "type": "text", "hint": "可填写纯频道 ID、从消息会话类型开始的尾部，或完整 unified_msg_origin；一项可匹配多个频道。", "default": ""},
              "language": {"description": "事件通知语言（每行一个）", "type": "text", "hint": "支持 zh_CN、en_US；可配置单语或多语，顺序即输出顺序。", "default": "zh_CN"},
              "chat_translation_enabled": {"description": "频道聊天自动翻译", "type": "bool", "default": false},
              "chat_translation_languages": {"description": "聊天翻译目标语言（每行一个）", "type": "text", "default": "en_us"},
              "chat_translation_show_original": {"description": "翻译后显示原文", "type": "bool", "default": true},
              "chat_translation_custom_instructions": {"description": "旧版频道翻译提示词（自动迁移）", "type": "text", "default": "", "invisible": true},
              "notifications_enabled": {"description": "事件通知总开关", "type": "bool", "default": true},
              "notify_server_start_enabled": {"description": "服务器连接通知", "type": "bool", "default": true},
              "notify_server_stop_enabled": {"description": "服务器断开通知", "type": "bool", "default": true},
              "notify_player_join_enabled": {"description": "玩家进入通知", "type": "bool", "default": true},
              "notify_player_leave_enabled": {"description": "玩家离开通知", "type": "bool", "default": true},
              "notify_player_death_enabled": {"description": "玩家死亡通知", "type": "bool", "default": true},
              "notify_server_start": {"description": "通用服务器连接模板（非空时覆盖多语）", "type": "text", "default": ""},
              "notify_server_stop": {"description": "通用服务器断开模板（非空时覆盖多语）", "type": "text", "default": ""},
              "notify_player_join": {"description": "通用玩家进入模板（非空时覆盖多语）", "type": "text", "default": ""},
              "notify_player_leave": {"description": "通用玩家离开模板（非空时覆盖多语）", "type": "text", "default": ""},
              "notify_player_death": {"description": "通用玩家死亡模板（非空时覆盖多语）", "type": "text", "default": ""},
              "localized_templates": {
                "description": "频道分语言自定义样式",
                "type": "object",
                "items": {
                  "zh_CN": {
                    "description": "简体中文样式",
                    "type": "object",
                    "items": {
                      "notify_server_start": {"description": "服务器连接", "type": "text", "default": ""},
                      "notify_server_stop": {"description": "服务器断开", "type": "text", "default": ""},
                      "notify_player_join": {"description": "玩家进入", "type": "text", "default": ""},
                      "notify_player_leave": {"description": "玩家离开", "type": "text", "default": ""},
                      "notify_player_death": {"description": "玩家死亡", "type": "text", "default": ""}
                    }
                  },
                  "en_US": {
                    "description": "English (US) styles",
                    "type": "object",
                    "items": {
                      "notify_server_start": {"description": "Server connected", "type": "text", "default": ""},
                      "notify_server_stop": {"description": "Server disconnected", "type": "text", "default": ""},
                      "notify_player_join": {"description": "Player joined", "type": "text", "default": ""},
                      "notify_player_leave": {"description": "Player left", "type": "text", "default": ""},
                      "notify_player_death": {"description": "Player death", "type": "text", "default": ""}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "binding_settings": {
    "description": "② 账号绑定、登录检查与白名单",
    "type": "object",
    "hint": "常用组合：VERIFY_CODE；开启“同步绑定到服务器”和“未绑定禁止登录”。Mod 侧还需开启 enableBindingSync、bindingSyncWhitelist、loginBindingCheckEnabled，并建议保持 loginCheckFailOpen=true。",
    "obvious_hint": true,
    "items": {
      "binding_enabled": {
        "description": "启用账号绑定",
        "type": "bool",
        "hint": "提供 /mc bind、unbind、bindings、who 及管理员绑定指令。",
        "default": true
      },
      "verify_method": {
        "description": "绑定验证方式",
        "type": "string",
        "options": ["GROUP_NAME", "VERIFY_CODE"],
        "hint": "推荐 VERIFY_CODE：玩家登录获取验证码，再在 QQ/Discord 使用 /mc bind <验证码>。",
        "obvious_hint": true,
        "default": "GROUP_NAME"
      },
      "need_bind_to_login": {
        "description": "未绑定登录拒绝消息开关",
        "type": "bool",
        "hint": "开启后，未绑定玩家会收到下方拒绝消息并被拒绝登录。Mod 侧还需 loginBindingCheckEnabled=true；loginCheckFailOpen=true 时 AstrBot 断线或超时仍放行。",
        "obvious_hint": true,
        "default": false
      },
      "sync_binding_to_server": {
        "description": "同步绑定到 Minecraft Mod",
        "type": "bool",
        "hint": "Mod 侧还需 enableBindingSync=true；原版白名单同步还需 bindingSyncWhitelist=true。",
        "obvious_hint": true,
        "default": false
      },
      "binding_sync_required": {
        "description": "服务器同步失败时回滚绑定",
        "type": "bool",
        "hint": "建议与同步绑定同时开启。服务端拒绝或超时会阻止/回滚 AstrBot 侧绑定变更。",
        "default": false
      },
      "max_bind_count": {
        "description": "单个聊天账号最大绑定数",
        "type": "int",
        "default": 1
      },
      "verify_code_expire_seconds": {
        "description": "验证码有效期（秒）",
        "type": "int",
        "default": 300
      },
      "bind_cooldown_seconds": {
        "description": "绑定冷却（秒）",
        "type": "int",
        "default": 60
      },
      "unbind_cooldown_seconds": {
        "description": "解绑冷却（秒）",
        "type": "int",
        "hint": "AQQBot 默认值为 86400；测试时可临时调低。",
        "default": 86400
      },
      "player_name_regex": {
        "description": "手填 Minecraft 玩家名规则",
        "type": "string",
        "hint": "仅用于 GROUP_NAME/管理员手填名称；验证码绑定使用服务端认证名。",
        "default": "^\\S{1,64}$"
      },
      "login_reject_message": {
        "description": "未绑定登录拒绝消息",
        "type": "string",
        "hint": "开启上方开关后返回给游戏玩家。预设内容在安装同版客户端 Mod 时跟随客户端语言，未安装时使用默认通知语言；自定义内容保持原文。自定义内容可使用 {code} 插入本次验证码，使用后 Mod 不会重复追加默认验证码提示。登录时尚未绑定平台，因此不区分 QQ/Discord。",
        "default": "[MC] 该游戏账号尚未在聊天平台绑定，请先使用 /mc bind <游戏名>。"
      },
      "binding_database": {
        "description": "绑定数据库路径（高级）",
        "type": "string",
        "hint": "通常无需修改；相对路径从 AstrBot 工作目录解析。",
        "default": "data/mineastr/bindings.sqlite3"
      }
    }
  },
  "qq_settings": {
    "description": "③ QQ / OneBot 自动化",
    "type": "object",
    "hint": "QQ群名片修改要求机器人是群管理员或群主。群号可以只填一个；多个群时每行一个。",
    "items": {
      "qq_auto_unbind_on_leave": {
        "description": "退群自动解绑",
        "type": "bool",
        "default": true
      },
      "qq_auto_group_card": {
        "description": "绑定后修改 QQ 群名片",
        "type": "bool",
        "hint": "机器人必须是群管理员或群主。",
        "default": true
      },
      "qq_group_ids": {
        "description": "允许自动操作的 QQ 群号（每行一个）",
        "type": "text",
        "hint": "只有一个群时直接写一行即可；留空表示当前 OneBot 实例收到的全部群。",
        "obvious_hint": true,
        "default": ""
      },
      "qq_group_card_template": {
        "description": "QQ 群名片模板",
        "type": "string",
        "hint": "推荐 {players}；多个游戏名按绑定顺序并列，超长时保留最早能完整放下的名称。",
        "default": "{players}"
      },
      "qq_notification_settings": {
        "description": "QQ 平台翻译、通知语言、开关与样式",
        "type": "object",
        "hint": "这里的设置只应用到下方平台 ID 对应的 QQ/OneBot 会话；聊天翻译和每条事件通知可分别开关。",
        "obvious_hint": true,
        "items": {
          "platform_ids": {
            "description": "QQ / OneBot 平台 ID（每行一个）",
            "type": "text",
            "hint": "通常是 default；如果 AstrBot 日志显示其他平台 ID，请按日志填写。",
            "default": "default"
          },
          "language": {
            "description": "QQ 通知语言（每行一个）",
            "type": "text",
            "hint": "单语只写一行；中英同时显示时写两行：zh_CN 和 en_US。输出顺序与这里一致。",
            "default": "zh_CN"
          },
          "chat_translation_enabled": {"description": "QQ 平台消息自动翻译", "type": "bool", "hint": "翻译从 Minecraft 或 Discord 转发到 QQ 的聊天消息；会调用上方配置的翻译模型。", "default": false},
          "chat_translation_languages": {"description": "QQ 聊天翻译目标语言（每行一个）", "type": "text", "hint": "使用 locale，例如 zh_cn、en_us、ja_jp；一行是单语，多行按顺序并列显示，最多 8 种。", "default": "zh_cn"},
          "chat_translation_show_original": {"description": "QQ 翻译后显示原文", "type": "bool", "default": true},
          "chat_translation_custom_instructions": {"description": "旧版 QQ 翻译提示词（自动迁移）", "type": "text", "default": "", "invisible": true},
          "notifications_enabled": {"description": "QQ 事件通知总开关", "type": "bool", "default": true},
          "notify_server_start_enabled": {"description": "QQ：服务器连接通知", "type": "bool", "default": true},
          "notify_server_stop_enabled": {"description": "QQ：服务器断开通知", "type": "bool", "default": true},
          "notify_player_join_enabled": {"description": "QQ：玩家进入通知", "type": "bool", "default": true},
          "notify_player_leave_enabled": {"description": "QQ：玩家离开通知", "type": "bool", "default": true},
          "notify_player_death_enabled": {"description": "QQ：玩家死亡通知", "type": "bool", "default": true},
          "notify_server_start": {"description": "QQ 通用服务器连接模板（高级兼容）", "type": "string", "hint": "非空时只发送这一份并覆盖多语言输出；多语言自定义请使用下方分语言样式。", "default": ""},
          "notify_server_stop": {"description": "QQ 通用服务器断开模板（高级兼容）", "type": "string", "hint": "非空时只发送这一份并覆盖多语言输出。", "default": ""},
          "notify_player_join": {"description": "QQ 通用玩家进入模板（高级兼容）", "type": "string", "hint": "非空时只发送这一份并覆盖多语言输出。", "default": ""},
          "notify_player_leave": {"description": "QQ 通用玩家离开模板（高级兼容）", "type": "string", "hint": "非空时只发送这一份并覆盖多语言输出。", "default": ""},
          "notify_player_death": {"description": "QQ 通用玩家死亡模板（高级兼容）", "type": "string", "hint": "非空时只发送这一份并覆盖多语言输出。", "default": ""},
          "localized_templates": {
            "description": "QQ 分语言自定义样式",
            "type": "object",
            "hint": "每种语言可分别定制五类通知；留空使用该语言预设。支持原有模板占位符，文本框内可换行。",
            "obvious_hint": true,
            "items": {
              "zh_CN": {
                "description": "简体中文样式",
                "type": "object",
                "items": {
                  "notify_server_start": {"description": "服务器连接", "type": "text", "default": ""},
                  "notify_server_stop": {"description": "服务器断开", "type": "text", "default": ""},
                  "notify_player_join": {"description": "玩家进入", "type": "text", "default": ""},
                  "notify_player_leave": {"description": "玩家离开", "type": "text", "default": ""},
                  "notify_player_death": {"description": "玩家死亡", "type": "text", "default": ""}
                }
              },
              "en_US": {
                "description": "English (US) styles",
                "type": "object",
                "items": {
                  "notify_server_start": {"description": "Server connected", "type": "text", "default": ""},
                  "notify_server_stop": {"description": "Server disconnected", "type": "text", "default": ""},
                  "notify_player_join": {"description": "Player joined", "type": "text", "default": ""},
                  "notify_player_leave": {"description": "Player left", "type": "text", "default": ""},
                  "notify_player_death": {"description": "Player death", "type": "text", "default": ""}
                }
              }
            }
          }
        }
      }
    }
  },
  "discord_settings": {
    "description": "④ Discord 自动化",
    "type": "object",
    "hint": "需要 Server Members Intent 和 Manage Nicknames；机器人角色必须高于目标成员。Guild ID 可以只填一个或每行一个。",
    "items": {
      "discord_auto_unbind_on_leave": {
        "description": "退群自动解绑",
        "type": "bool",
        "default": true
      },
      "discord_auto_nickname": {
        "description": "绑定后自动修改 Discord 昵称",
        "type": "bool",
        "default": true
      },
      "discord_restore_nickname_on_unbind": {
        "description": "全部解绑后恢复原昵称",
        "type": "bool",
        "default": true
      },
      "discord_guild_ids": {
        "description": "允许自动操作的 Guild ID（每行一个）",
        "type": "text",
        "hint": "只有一个服务器时直接写一行即可；留空表示当前 Discord 实例加入的全部服务器。",
        "obvious_hint": true,
        "default": ""
      },
      "discord_nickname_template": {
