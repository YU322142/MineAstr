{
  "bridge_settings": {
    "description": "① 群服互联与聊天转发",
    "type": "object",
    "hint": "配置 QQ 群、Discord 频道与 Minecraft 的双向聊天。建议直接在目标会话执行 /mc bridge_add，不必手填会话 ID。",
    "obvious_hint": true,
    "items": {
      "bridge_enabled": {
        "description": "启用群服互联",
        "type": "bool",
        "hint": "启用后，桥接会话列表中的 QQ 群或 Discord 频道会与 Minecraft 双向转发文本消息。",
        "default": true
      },
      "relay_sessions": {
        "description": "桥接会话列表（每行一个）",
        "type": "text",
        "hint": "推荐在目标群/频道执行 /mc bridge_add 自动写入。手填时每行一个 AstrBot unified_msg_origin。",
        "obvious_hint": true,
        "default": ""
      },
      "relay_prefix": {
        "description": "聊天平台转游戏前缀",
        "type": "string",
        "hint": "留空转发普通消息；设置后只有以此前缀开头的消息才会进入游戏。",
        "default": ""
      },
      "relay_wake_messages": {
        "description": "同时转发唤醒机器人消息",
        "type": "bool",
        "hint": "默认关闭，避免 @AstrBot 的对话同时刷入游戏。",
        "default": false
      },
      "relay_commands": {
        "description": "把斜杠指令也转发进游戏聊天",
        "type": "bool",
        "hint": "这只控制聊天转发，不等于开启服务器远程命令。建议保持关闭。",
        "default": false
      },
      "chat_to_game_template": {
        "description": "聊天平台到游戏模板",
        "type": "string",
        "hint": "支持 {platform}、{sender}、{user_id}、{message}。",
        "default": "{message}"
      },
      "game_to_chat_template": {
        "description": "游戏到聊天平台模板",
        "type": "string",
        "hint": "支持 {server}、{server_id}、{player}、{player_uuid}、{message}。",
        "default": "[MC/{server}] {player}: {message}"
      },
      "chat_to_game_filters": {
        "description": "聊天平台到游戏过滤规则（每行一条）",
        "type": "text",
        "hint": "支持 $filter、$regex、$replaceTo 和 !CANCEL。",
        "default": ""
      },
      "game_to_chat_filters": {
        "description": "游戏到聊天平台过滤规则（每行一条）",
        "type": "text",
        "hint": "为避免 SSRF，只支持本地规则，不加载 $url 远程词库。",
        "default": ""
      },
      "max_relay_length": {
        "description": "跨平台转发最大字数",
        "type": "int",
        "hint": "超出长度会截断；Discord 自身仍有 2000 字限制。",
        "default": 500
      }
    }
  },
  "binding_settings": {
    "description": "② 账号绑定、登录检查与白名单",
    "type": "object",
    "hint": "常用组合：VERIFY_CODE；开启“同步绑定到服务器”和“未绑定禁止登录”。Mod 侧还需开启 enableBindingSync、bindingSyncWhitelist、loginBindingCheckEnabled，并建议保持 loginCheckFailOpen=true。",
    "obvious_hint": true,
    "items": {
      "binding_enabled": {
        "description": "启用账号绑定",
        "type": "bool",
        "hint": "提供 /mc bind、unbind、bindings、who 及管理员绑定指令。",
        "default": true
      },
      "verify_method": {
        "description": "绑定验证方式",
        "type": "string",
        "options": ["GROUP_NAME", "VERIFY_CODE"],
        "hint": "推荐 VERIFY_CODE：玩家登录获取验证码，再在 QQ/Discord 使用 /mc bind <验证码>。",
        "obvious_hint": true,
        "default": "GROUP_NAME"
      },
      "need_bind_to_login": {
        "description": "未绑定登录拒绝消息开关",
        "type": "bool",
        "hint": "开启后，未绑定玩家会收到下方拒绝消息并被拒绝登录。Mod 侧还需 loginBindingCheckEnabled=true；loginCheckFailOpen=true 时 AstrBot 断线或超时仍放行。",
        "obvious_hint": true,
        "default": false
      },
      "sync_binding_to_server": {
        "description": "同步绑定到 Minecraft Mod",
        "type": "bool",
        "hint": "Mod 侧还需 enableBindingSync=true；原版白名单同步还需 bindingSyncWhitelist=true。",
        "obvious_hint": true,
        "default": false
      },
      "binding_sync_required": {
        "description": "服务器同步失败时回滚绑定",
        "type": "bool",
        "hint": "建议与同步绑定同时开启。服务端拒绝或超时会阻止/回滚 AstrBot 侧绑定变更。",
        "default": false
      },
      "max_bind_count": {
        "description": "单个聊天账号最大绑定数",
        "type": "int",
        "default": 1
      },
      "verify_code_expire_seconds": {
        "description": "验证码有效期（秒）",
        "type": "int",
        "default": 300
      },
      "bind_cooldown_seconds": {
        "description": "绑定冷却（秒）",
        "type": "int",
        "default": 60
      },
      "unbind_cooldown_seconds": {
        "description": "解绑冷却（秒）",
        "type": "int",
        "hint": "AQQBot 默认值为 86400；测试时可临时调低。",
        "default": 86400
      },
      "player_name_regex": {
        "description": "手填 Minecraft 玩家名规则",
        "type": "string",
        "hint": "仅用于 GROUP_NAME/管理员手填名称；验证码绑定使用服务端认证名。",
        "default": "^\\S{1,64}$"
      },
      "login_reject_message": {
        "description": "未绑定登录拒绝消息",
        "type": "string",
        "hint": "开启上方开关后返回给游戏玩家。预设内容在安装同版客户端 Mod 时跟随客户端语言，未安装时使用默认通知语言；自定义内容保持原文。登录时尚未绑定平台，因此不区分 QQ/Discord。",
        "default": "[MC] 该游戏账号尚未在聊天平台绑定，请先使用 /mc bind <游戏名>。"
      },
      "binding_database": {
        "description": "绑定数据库路径（高级）",
        "type": "string",
        "hint": "通常无需修改；相对路径从 AstrBot 工作目录解析。",
        "default": "data/mineastr/bindings.sqlite3"
      }
    }
  },
  "qq_settings": {
    "description": "③ QQ / OneBot 自动化",
    "type": "object",
    "hint": "QQ群名片修改要求机器人是群管理员或群主。群号可以只填一个；多个群时每行一个。",
    "items": {
      "qq_auto_unbind_on_leave": {
        "description": "退群自动解绑",
        "type": "bool",
        "default": true
      },
      "qq_auto_group_card": {
        "description": "绑定后修改 QQ 群名片",
        "type": "bool",
        "hint": "机器人必须是群管理员或群主。",
        "default": true
      },
      "qq_group_ids": {
        "description": "允许自动操作的 QQ 群号（每行一个）",
        "type": "text",
        "hint": "只有一个群时直接写一行即可；留空表示当前 OneBot 实例收到的全部群。",
        "obvious_hint": true,
        "default": ""
      },
      "qq_group_card_template": {
        "description": "QQ 群名片模板",
        "type": "string",
        "hint": "推荐 {players}；多个游戏名按绑定顺序并列，超长时保留最早能完整放下的名称。",
        "default": "{players}"
      },
      "qq_notification_settings": {
        "description": "QQ 通知语言、开关与模板",
        "type": "object",
        "hint": "这里的设置只应用到下方平台 ID 对应的 QQ/OneBot 会话；每条通知可单独关闭，模板留空时使用所选语言预设。",
        "obvious_hint": true,
        "items": {
          "platform_ids": {
            "description": "QQ / OneBot 平台 ID（每行一个）",
            "type": "text",
            "hint": "通常是 default；如果 AstrBot 日志显示其他平台 ID，请按日志填写。",
            "default": "default"
          },
          "language": {
            "description": "QQ 通知语言",
            "type": "string",
            "options": ["zh_CN", "en_US"],
            "default": "zh_CN"
          },
          "notifications_enabled": {"description": "QQ 事件通知总开关", "type": "bool", "default": true},
          "notify_server_start_enabled": {"description": "QQ：服务器连接通知", "type": "bool", "default": true},
          "notify_server_stop_enabled": {"description": "QQ：服务器断开通知", "type": "bool", "default": true},
          "notify_player_join_enabled": {"description": "QQ：玩家进入通知", "type": "bool", "default": true},
          "notify_player_leave_enabled": {"description": "QQ：玩家离开通知", "type": "bool", "default": true},
          "notify_player_death_enabled": {"description": "QQ：玩家死亡通知", "type": "bool", "default": true},
          "notify_server_start": {"description": "QQ 服务器连接模板（留空使用语言预设）", "type": "string", "default": ""},
          "notify_server_stop": {"description": "QQ 服务器断开模板（留空使用语言预设）", "type": "string", "default": ""},
          "notify_player_join": {"description": "QQ 玩家进入模板（留空使用语言预设）", "type": "string", "default": ""},
          "notify_player_leave": {"description": "QQ 玩家离开模板（留空使用语言预设）", "type": "string", "default": ""},
          "notify_player_death": {"description": "QQ 玩家死亡模板（留空使用语言预设）", "type": "string", "default": ""}
        }
      }
    }
  },
  "discord_settings": {
    "description": "④ Discord 自动化",
    "type": "object",
    "hint": "需要 Server Members Intent 和 Manage Nicknames；机器人角色必须高于目标成员。Guild ID 可以只填一个或每行一个。",
    "items": {
      "discord_auto_unbind_on_leave": {
        "description": "退群自动解绑",
        "type": "bool",
        "default": true
      },
      "discord_auto_nickname": {
        "description": "绑定后自动修改 Discord 昵称",
        "type": "bool",
        "default": true
      },
      "discord_restore_nickname_on_unbind": {
        "description": "全部解绑后恢复原昵称",
        "type": "bool",
        "default": true
      },
      "discord_guild_ids": {
        "description": "允许自动操作的 Guild ID（每行一个）",
        "type": "text",
        "hint": "只有一个服务器时直接写一行即可；留空表示当前 Discord 实例加入的全部服务器。",
        "obvious_hint": true,
        "default": ""
      },
      "discord_nickname_template": {
        "description": "Discord 昵称模板",
        "type": "string",
        "hint": "推荐 {players}；超出 32 字符时只保留最早能完整放下的游戏名。",
        "default": "{players}"
      },
      "discord_nickname_reason": {
        "description": "Discord 审计日志原因",
        "type": "string",
        "default": "MineAstr Minecraft 账号绑定同步"
      },
      "discord_notification_settings": {
        "description": "Discord 通知语言、开关与模板",
        "type": "object",
        "hint": "这里的设置只应用到下方平台 ID 对应的 Discord 会话；每条通知可单独关闭，模板留空时使用所选语言预设。",
        "obvious_hint": true,
        "items": {
          "platform_ids": {
            "description": "Discord 平台 ID（每行一个）",
            "type": "text",
            "hint": "通常是 discord；如果 AstrBot 日志显示 discord-main 等其他 ID，请按日志填写。",
            "default": "discord"
          },
          "language": {
            "description": "Discord 通知语言",
            "type": "string",
            "options": ["zh_CN", "en_US"],
            "default": "zh_CN"
          },
          "notifications_enabled": {"description": "Discord 事件通知总开关", "type": "bool", "default": true},
          "notify_server_start_enabled": {"description": "Discord：服务器连接通知", "type": "bool", "default": true},
          "notify_server_stop_enabled": {"description": "Discord：服务器断开通知", "type": "bool", "default": true},
          "notify_player_join_enabled": {"description": "Discord：玩家进入通知", "type": "bool", "default": true},
          "notify_player_leave_enabled": {"description": "Discord：玩家离开通知", "type": "bool", "default": true},
          "notify_player_death_enabled": {"description": "Discord：玩家死亡通知", "type": "bool", "default": true},
          "notify_server_start": {"description": "Discord 服务器连接模板（留空使用语言预设）", "type": "string", "default": ""},
          "notify_server_stop": {"description": "Discord 服务器断开模板（留空使用语言预设）", "type": "string", "default": ""},
          "notify_player_join": {"description": "Discord 玩家进入模板（留空使用语言预设）", "type": "string", "default": ""},
          "notify_player_leave": {"description": "Discord 玩家离开模板（留空使用语言预设）", "type": "string", "default": ""},
          "notify_player_death": {"description": "Discord 玩家死亡模板（留空使用语言预设）", "type": "string", "default": ""}
        }
      }
    }
  },
  "admin_command_settings": {
    "description": "⑤ 管理员与远程服务器指令",
    "type": "object",
    "hint": "两层安全开关：这里允许 /mc command；Mod 的 mineastr-common.json 还必须设置 enableCommandTool=true、trustedCommandUsers 和 allowedCommandRules。不要使用 [\"*\"]。",
    "obvious_hint": true,
    "items": {
      "bridge_admin_users": {
        "description": "MineAstr 管理员账号（每行一个）",
        "type": "text",
        "hint": "QQ 示例 default:123456789；Discord 示例 discord:123456789012345678。也可只写用户 ID。只有一个管理员时写一行即可。",
        "obvious_hint": true,
        "default": ""
      },
      "remote_command_enabled": {
        "description": "启用 /mc command",
        "type": "bool",
        "hint": "这里只开启聊天指令入口；Mod 侧 enableCommandTool=false 时仍会拒绝。",
        "obvious_hint": true,
        "default": false
      },
      "remote_command_admin_only": {
        "description": "仅 MineAstr 管理员可执行",
        "type": "bool",
        "hint": "强烈建议保持开启。",
        "default": true
      }
    }
  },
  "notification_settings": {
    "description": "⑥ 玩家提醒与事件通知",
    "type": "object",
    "hint": "这里是未匹配平台时使用的全局默认值。QQ 与 Discord 的独立语言、开关和模板分别位于上方 QQ / Discord 设置区。",
    "obvious_hint": true,
    "items": {
      "player_mention_enabled": {
        "description": "启用聊天平台 @游戏玩家",
        "type": "bool",
        "default": true
      },
      "notifications_enabled": {
        "description": "事件通知总开关",
        "type": "bool",
        "default": true
      },
      "notification_language": {
        "description": "默认通知语言",
        "type": "string",
        "options": ["zh_CN", "en_US"],
        "hint": "中文（简体）或 English (US)。仅预设模板会自动翻译，自定义模板保持原文。",
        "default": "zh_CN"
      },
      "notify_server_start_enabled": {
        "description": "发送服务器连接通知",
        "type": "bool",
        "default": true
      },
      "notify_server_start": {
        "description": "服务器连接通知模板",
        "type": "string",
        "hint": "支持 {server}、{server_id}。",
        "default": "[MC] {server} 已连接。"
      },
      "notify_server_stop_enabled": {
        "description": "发送服务器断开通知",
        "type": "bool",
        "default": true
      },
      "notify_server_stop": {
        "description": "服务器断开通知模板",
        "type": "string",
        "hint": "支持 {server}、{server_id}。",
        "default": "[MC] {server} 已断开。"
      },
      "notify_player_join_enabled": {
        "description": "发送玩家进入通知",
        "type": "bool",
        "default": true
      },
      "notify_player_join": {
        "description": "玩家进入通知模板",
        "type": "string",
        "hint": "支持 {player}、{binding}、{owner}、{user_id}、{server}、{server_id}。",
        "default": "[MC] {player}{binding} 进入了服务器。"
      },
      "notify_player_leave_enabled": {
        "description": "发送玩家离开通知",
        "type": "bool",
        "default": true
      },
      "notify_player_leave": {
        "description": "玩家离开通知模板",
        "type": "string",
        "hint": "支持 {player}、{binding}、{owner}、{user_id}、{server}、{server_id}。",
        "default": "[MC] {player}{binding} 离开了服务器。"
      },
      "notify_player_death_enabled": {
        "description": "发送玩家死亡通知",
        "type": "bool",
        "default": true
      },
      "notify_player_death": {
        "description": "玩家死亡通知模板",
        "type": "string",
        "hint": "支持 {reason}、{death_type}、{attacker}、{direct_entity}、{weapon}，以及玩家/服务器占位符。",
        "default": "[MC] {player}{binding} 因 {reason} 在游戏内死亡。"
      }
    }
  },
